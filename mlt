APP.PY
from flask import Flask, request
import joblib
import pandas as pd

app = Flask(__name__)

# Load model
model = joblib.load("model.pkl")

@app.route("/")
def home():
    return '''
    <h2>Search Ranking Optimization System</h2>
    <form action="/predict" method="post">
        Relevance: <input type="text" name="relevance"><br><br>
        Clicks: <input type="text" name="clicks"><br><br>
        User Rating: <input type="text" name="user_rating"><br><br>
        <input type="submit" value="Predict Ranking">
    </form>
    '''

@app.route("/predict", methods=["POST"])
def predict():
    relevance = float(request.form["relevance"])
    clicks = float(request.form["clicks"])
    user_rating = float(request.form["user_rating"])

    input_data = pd.DataFrame(
        [[relevance, clicks, user_rating]],
        columns=["relevance", "clicks", "user_rating"]
    )

    predicted_score = model.predict(input_data)[0]

    websites = {
        "Website A": predicted_score,
        "Website B": 72,
        "Website C": 95,
        "Website D": 65
    }

    ranked_results = sorted(
        websites.items(),
        key=lambda x: x[1],
        reverse=True
    )

    result_text = f"<h3>Predicted Ranking Score: {predicted_score:.2f}</h3>"
    result_text += "<h3>Final Ranked Results:</h3>"

    for i, site in enumerate(ranked_results, start=1):
        result_text += f"{i}. {site[0]} - Score: {site[1]}<br>"

    return result_text

if __name__ == "__main__":
    app.run(debug=True)

